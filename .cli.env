# ============================================================================
# Red Flags Thresholds Configuration
# ============================================================================
# Customize thresholds for financial red flag detection
# Use red_flags__ prefix with double underscore for nested settings
# Tiered thresholds: _critical (most severe), _warning (moderate), _info (FYI)
# ============================================================================

# Balance Sheet Health - TIERED THRESHOLDS
# red_flags__debt_to_equity_ratio_warning=1.0       # Warning if D/E > this
# red_flags__debt_to_equity_ratio_critical=2.0      # Critical if D/E > this (severe overleveraging)
# red_flags__current_ratio_critical=1.0             # Critical if < this (severe liquidity crisis)
# red_flags__current_ratio_warning=1.5              # Warning if < this (liquidity concerns)
# red_flags__quick_ratio_critical=0.5               # Critical if < this (severe liquidity)
# red_flags__quick_ratio_warning=1.0                # Warning if < this (cannot meet obligations)
# red_flags__interest_coverage_critical=1.5         # Critical if < this (imminent default risk)
# red_flags__interest_coverage_warning=3.0          # Warning if < this (default risk)

# Cash Flow Quality
# red_flags__stock_comp_percent_ocf=10.0       # Warning if SBC > this % of OCF

# Profitability & Income Quality
# red_flags__net_margin_percent=3.0            # Info if net margin < this %
# red_flags__roe_percent=10.0                  # Info if ROE < this %
# red_flags__roic_percent=7.0                  # Info if ROIC < this %
# red_flags__gross_margin_std_dev=5.0          # Info if GM volatility > this %

# Growth & Sustainability - TIERED THRESHOLDS
# red_flags__revenue_cagr_inflation=3.0             # Info if 5yr revenue CAGR < this %
# red_flags__sga_percent_revenue_info=25.0          # Info if SG&A > this % of revenue
# red_flags__sga_percent_revenue_warning=30.0       # Warning if SG&A > this % (bloated overhead)
# red_flags__sga_increase_threshold=3.0             # Info if SG&A % increases by > this
# red_flags__revenue_growth_for_rd_check=5.0        # Revenue growth needed for R&D check
# red_flags__rd_decline_threshold=-5.0              # Warning if R&D declines by > this %

# Valuation Concerns
# red_flags__price_to_sales=10.0               # Info if P/S > this
# red_flags__pe_ratio_low=5.0                  # Info if P/E < this with low growth
# red_flags__price_to_book=5.0                 # Info if P/B > this without high ROE
# red_flags__roe_for_pb_check=15.0             # ROE % needed to justify high P/B
# red_flags__dividend_yield=8.0                # Warning if dividend yield > this %
# red_flags__peg_ratio=2.0                     # Info if PEG > this (Yahoo Finance)
# red_flags__ev_to_ebitda=15.0                 # Info if EV/EBITDA > this (Yahoo Finance)
# red_flags__short_interest_percent=10.0       # Warning if short interest > this %
# red_flags__insider_ownership_percent=2.0     # Info if insider ownership < this %